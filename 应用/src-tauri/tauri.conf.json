{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlassDesign",
  "version": "0.1.0",
  "identifier": "com.glassdesign.gallery",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "GlassDesign",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": true,
        "label": "main",
        "backgroundColor": "#101014"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}