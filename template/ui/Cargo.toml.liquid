[package]
name = "{{project-name}}-ui"
version = "0.1.0"
edition = "2021"

[dependencies]
# 三个都得写。`#[component]` / `view!` 展开成 `::leptos::…` 绝对路径，
# `#[wasm_bindgen]` 展开成 `::wasm_bindgen::…`，都指向本 crate 根的外部 crate。
# re-export 只多给一个 `glass_design::leptos` 路径，替代不了声明。
# 别写 `=0.8.x` 精确锁：库用 caret，锁死会各拿一份 leptos，`Signal` 变成两个类型。
leptos = { version = "0.8", features = ["csr"] }
wasm-bindgen = "0.2"
glass-design = "0.8"

[lib]
crate-type = ["cdylib", "rlib"]
